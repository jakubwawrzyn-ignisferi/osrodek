# Wzór pliku .env. Skopiuj go jako .env i uzupełnij. Plik .env nie trafia do repozytorium.
# Żadna z tych wartości nie jest tajna - frontend nie potrzebuje haseł do WordPressa.

# Adres instalacji WordPressa (bez ukośnika na końcu). Stąd przy budowaniu pobierane są
# treści, a adresy zdjęć i plików w gotowej stronie wskazują na ten WordPress.
# Produkcja: https://mos.tiu.pl/cms   Lokalnie (program Local): http://osrodek.local
WP_URL=https://mos.tiu.pl/cms

# Adres strony (bez ukośnika na końcu). Włącza mapę strony (sitemap) i pełne adresy
# w podglądzie linków (canonical, og:url). Pusty = bez mapy strony i tych znaczników.
SITE_URL=https://mos.tiu.pl

# true = strona nie trafia do wyszukiwarek: znacznik noindex na każdej podstronie,
# bez mapy strony i bez linku do niej w robots.txt. Na czas działania pod tymczasowym
# adresem mos.tiu.pl. Po podpięciu docelowej domeny ustaw false (albo usuń wiersz).
NOINDEX=true
