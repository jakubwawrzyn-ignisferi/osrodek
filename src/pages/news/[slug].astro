---
// src/pages/news/[slug].astro - pojedyncza aktualność, np. /news/nabor-2025-2026
// Przy budowaniu strony powstaje osobny plik HTML dla każdego wpisu z WordPressa.
import Layout from '../../layouts/Layout.astro';
import NewsArticle from '../../components/NewsArticle.jsx';
import { getAllPosts, formatDate } from '../../lib/wordpress.js';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
---
<Layout title={post.title}>
    <NewsArticle
        title={post.title}
        date={formatDate(post.date)}
        dateIso={post.date}
        image={post.image}
        contentHtml={post.contentHtml}
    />
</Layout>
