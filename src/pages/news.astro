---
// src/pages/news.astro - lista wszystkich aktualności
import Layout from '../layouts/Layout.astro';
import NewsSection from '../components/NewsSection/NewsSection.jsx';
import { getAllPosts } from '../lib/wordpress.js';

const posts = await getAllPosts();
---
<Layout title="Aktualności">
    <NewsSection posts={posts} showAllLink={false} />
</Layout>
