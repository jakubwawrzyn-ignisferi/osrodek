---
// src/pages/o-nas.astro
// Treść: strona WP "nasza-misja" (obrazek wyróżniający = zdjęcie w nagłówku).
// Pod treścią karty placówek z src/data/content.js.
import Layout from '../layouts/Layout.astro';
import Banner from '../components/Banner/Banner.jsx';
import Units from '../components/Units/Units.jsx';
import { getPage } from '../lib/wordpress.js';
import { units } from '../data/content.js';

const page = await getPage('nasza-misja');
const title = page?.title || 'Nasza misja';
---
<Layout title="O nas" image={page?.image}>
    <Banner titleTop="O nas" titleBottom={title} image={page?.image} />
    <article class="content-card">
        {page?.contentHtml ? (
            <div class="wp-content" set:html={page.contentHtml} />
        ) : (
            <p class="pending">Treść tej strony jest w przygotowaniu.</p>
        )}
    </article>
    <Units units={units} />
</Layout>
