---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.jsx';
import NewsSection from '../components/NewsSection.jsx';
import { getPage, getLatestPosts } from '../lib/wordpress.js';

// Pobieranie danych (Hero + Aktualności)
const pageData = await getPage('strona-glowna');
const pageTitle = pageData?.title || 'Witaj na stronie!';
const pageContent = pageData?.contentHtml || '<p>Brak treści z WP.</p>';

const latestPosts = await getLatestPosts(3);
---
<Layout title={pageTitle}>
    {/* Sekcja Aktualności */}
    <NewsSection posts={latestPosts} />

    {/* Sekcja Hero */}
    <Hero title={pageTitle} content={pageContent} />
</Layout>
