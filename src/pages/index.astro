---
// src/pages/index.astro
// Strona główna: dwie połowy z kafelkami (src/data/sections.js) i najnowsze aktualności.
// Tło połówek to sam gradient (HomeSplit.module.css), zdjęcie kafelka = obrazek wyróżniający
// strony WP o slugu kafelka.
import Layout from '../layouts/Layout.astro';
import HomeSplit from '../components/HomeSplit/HomeSplit.jsx';
import NewsSection from '../components/NewsSection/NewsSection.jsx';
import { home, withImages } from '../data/sections.js';
import { getAllPages, getLatestPosts } from '../lib/wordpress.js';

const pages = await getAllPages();
const halves = home.halves.map((half) => ({
    ...half,
    href: pages.has(half.slug) ? `/${half.slug}` : null,
    tiles: withImages(half.tiles, pages),
}));

const latestPosts = await getLatestPosts(3);
---
<Layout title="Salezjański Dom Młodzieżowy w Różanymstoku" tagline="Razem w stronę lepszych możliwości">
    <HomeSplit halves={halves} slogan={home.slogan} />
    <NewsSection posts={latestPosts} title="Z życia ośrodka" />
</Layout>
