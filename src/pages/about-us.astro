---
// src/pages/about-us.astro
import Layout from '../layouts/Layout.astro';
import AboutUs from '../components/AboutUs/AboutUs.jsx';
import { getPage } from '../lib/wordpress.js';

// Strona WP o slugu "nasza-misja" (razem z obrazkiem wyróżniającym jako banerem)
const pageData = await getPage('nasza-misja');
const title = pageData?.title || 'Nasza misja';
const content = pageData?.contentHtml || '<p>Brak treści.</p>';
const bannerUrl = pageData?.image?.url || null;
---
<Layout title={title}>
    <AboutUs
        title={title}
        bannerUrl={bannerUrl}
        contentHtml={content}
    />
</Layout>
