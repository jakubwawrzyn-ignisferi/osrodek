---
// src/pages/aktualnosci/[slug].astro - pojedyncza aktualność, np. /aktualnosci/nabor-2025-2026/
// Przy budowaniu strony powstaje osobny plik HTML dla każdego wpisu z WordPressa.
import Layout from '../../layouts/Layout.astro';
import Banner from '../../components/Banner/Banner.jsx';
import NewsArticle from '../../components/NewsArticle/NewsArticle.jsx';
import { getAllPosts, formatDate } from '../../lib/wordpress.js';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
---
<Layout title={post.title} description={post.excerpt || undefined} image={post.image}>
    <Banner as="p" titleTop="Aktualności" words={['Z życia ośrodka']} image={post.image} />
    <NewsArticle
        title={post.title}
        date={formatDate(post.date)}
        dateIso={post.date}
        contentHtml={post.contentHtml}
    />
</Layout>
