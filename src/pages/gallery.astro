---
// src/pages/gallery.astro
// Galeria jest w przygotowaniu - zdjęcia trafią tu z WordPressa.
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader/PageHeader.jsx';
---
<Layout title="Galeria">
    <PageHeader
        eyebrow="Galeria"
        title="Życie w Różanymstoku"
        lead="Stadnina, warsztaty, sport, wyjazdy i codzienność ośrodka."
    />
    <div class="placeholder">
        <p>Galeria zdjęć jest w przygotowaniu.</p>
    </div>
</Layout>

<style>
    .placeholder {
        max-width: var(--reading-width);
        margin: var(--section-space) auto;
        padding: 2rem;
        border-radius: var(--radius-lg);
        background-color: var(--color-bg);
        text-align: center;
        color: var(--color-text-muted);
    }
</style>
